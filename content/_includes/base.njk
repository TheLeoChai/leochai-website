<!doctype html>
<html lang="{{ route.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ route.title }}{% if route.key != 'home' %} · {{ metadata.title }}{% endif %}</title>
  <meta name="description" content="{{ route.description }}">
  <meta name="content-revision" content="{{ route.revision }}">
  {% if route.sourceRevision %}<meta name="translation-source-revision" content="{{ route.sourceRevision }}">{% endif %}
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/typography.css">
  <link rel="canonical" href="{{ route.canonical | canonicalUrl }}">
  <link rel="alternate" type="application/atom+xml" title="{% if route.locale == 'zh' %}Leo Chai — 笔记{% else %}Leo Chai — Notes{% endif %}" href="/{{ route.locale }}/rss.xml">
  {% for alternate in route.alternates %}<link rel="alternate" hreflang="{{ alternate.lang }}" href="{{ alternate.path | canonicalUrl }}">
  {% endfor %}
  <link rel="stylesheet" href="/css/components.css">
  {% for style in route.pageStyles or pageStyles %}<link rel="stylesheet" href="{{ style }}">{% endfor %}
  {% for script in route.pageScripts or pageScripts %}<script type="module" src="{{ script }}"></script>{% endfor %}
</head>
<body>
  <a class="skip-link" href="#main">{% if route.locale == 'zh' %}跳到正文{% else %}Skip to content{% endif %}</a>
  {% include "components/nav.njk" %}
  <main class="site-main site-width" id="main" tabindex="-1">{% block main %}{{ content | safe }}{% endblock %}</main>
  {% include "components/footer.njk" %}
</body>
</html>
