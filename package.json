{
  "name": "leochai-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:preview": "node scripts/build.mjs --pathprefix=/leochai-website/",
    "check": "node scripts/build.mjs --check-all",
    "dev": "bash scripts/dev.sh",
    "test": "node --test",
    "fonts:generate": "python3 scripts/generate-fonts.py",
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "check:content": "node scripts/check-content.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@11ty/eleventy-plugin-rss": "2.0.4",
    "color-name": "2.1.1",
    "linkedom": "0.18.12",
    "postcss-value-parser": "4.2.0",
    "stylelint": "17.15.0"
  }
}
